function cloneItems() {
  const cloned = JSON.parse(JSON.stringify(ITEMS));
  // Shuffle answer positions once per session; the saved session preserves the layout on resume.
  cloned.forEach(item => {
    if (!Array.isArray(item.options) || typeof item.answerIndex !== 'number') return;
    const options = item.options.map((value, index) => ({ value, correct: index === item.answerIndex }));
    for (let i = options.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [options[i], options[j]] = [options[j], options[i]];
    }
    item.options = options.map(option => option.value);
    item.answerIndex = options.findIndex(option => option.correct);
  });
  return cloned;
}
function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
}
function saveSession() {
  if (!session) return;
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(session)); }
