<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="color-scheme" content="light dark">
<title>Intelligere — private cognitive screening</title>
<style>
:root {
  color-scheme: light dark;
  --bg: #f4f6f7;
  --panel: #ffffff;
  --panel-soft: #eef2f4;
  --text: #17252d;
  --muted: #52636d;
  --line: #d3dce1;
  --accent: #245b70;
  --accent-strong: #164254;
  --accent-soft: #e1edf1;
  --focus: #b45309;
  --good: #23644e;
  --warn: #815b17;
  --shadow: 0 8px 28px rgba(17, 36, 45, .07);
  --radius: 18px;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #11191e;
    --panel: #1a252c;
    --panel-soft: #223039;
    --text: #ecf2f4;
    --muted: #b2c0c7;
    --line: #3a4b55;
    --accent: #a5d5e5;
    --accent-strong: #c5e7f0;
    --accent-soft: #293f49;
    --focus: #f2c078;
    --good: #9bd3b8;
    --warn: #f0cf82;
    --shadow: 0 8px 28px rgba(0, 0, 0, .18);
  }
}
* { box-sizing: border-box; }
html { min-height: 100%; background: var(--bg); }
body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 17px;
  line-height: 1.62;
  -webkit-font-smoothing: antialiased;
}
button, input { font: inherit; }
button { cursor: pointer; }
button:disabled { cursor: not-allowed; opacity: .48; }
button:focus-visible, input:focus-visible, a:focus-visible, label:focus-within {
  outline: 3px solid var(--focus);
  outline-offset: 3px;
}
a { color: var(--accent); text-underline-offset: 3px; overflow-wrap: anywhere; }
.wrap { width: min(100% - 28px, 820px); margin: 0 auto; padding: 20px 0 36px; }
.topline { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 0 0 16px; }
.eyebrow { color: var(--muted); font-size: .82rem; font-weight: 700; letter-spacing: .045em; text-transform: uppercase; }
.local-note { color: var(--muted); font-size: .84rem; text-align: right; }
.card {
  background: var(--panel);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: clamp(20px, 5vw, 34px);
}
.intro-title { font-size: clamp(1.9rem, 6vw, 2.8rem); line-height: 1.13; letter-spacing: -.035em; margin: 0 0 14px; }
h1, h2, h3 { line-height: 1.25; letter-spacing: -.02em; }
h1 { font-size: clamp(1.55rem, 4.4vw, 2.15rem); margin: 0 0 12px; }
h2 { font-size: 1.23rem; margin: 28px 0 10px; }
h3 { font-size: 1.02rem; margin: 18px 0 8px; }
p { margin: 0 0 14px; }
.muted { color: var(--muted); }
.small { font-size: .91rem; }
.disclaimer { border: 1px solid var(--line); border-left: 5px solid var(--accent); border-radius: 12px; padding: 16px 17px; margin: 22px 0; background: var(--panel-soft); }
.disclaimer h2 { margin: 0 0 8px; font-size: 1.05rem; }
.disclaimer p:last-child { margin-bottom: 0; }
.settings { margin: 20px 0; display: grid; gap: 12px; }
.checkline { display: flex; gap: 12px; align-items: flex-start; padding: 13px 14px; border: 1px solid var(--line); border-radius: 12px; min-height: 52px; }
.checkline input { width: 22px; height: 22px; flex: 0 0 auto; margin: 2px 0 0; accent-color: var(--accent); }
.actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
.btn {
  border: 1px solid var(--accent);
  border-radius: 12px;
  min-height: 48px;
  padding: 11px 18px;
  color: var(--panel);
  background: var(--accent);
  font-weight: 700;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.btn:hover:not(:disabled) { background: var(--accent-strong); }
.btn.secondary { background: transparent; color: var(--text); border-color: var(--line); }
.btn.secondary:hover:not(:disabled) { background: var(--panel-soft); }
.btn.danger { border-color: var(--line); background: transparent; color: var(--muted); }
.saved-box { margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); }
.session-bar { position: sticky; top: 0; z-index: 10; background: var(--bg); padding: 8px 0 13px; margin-bottom: 12px; }
.session-row { display: flex; gap: 14px; justify-content: space-between; align-items: center; margin-bottom: 8px; }
.session-meta { min-width: 0; }
.session-step { color: var(--muted); font-size: .87rem; }
.session-domain { font-weight: 750; font-size: .98rem; overflow-wrap: anywhere; }
.meter { height: 8px; border-radius: 999px; background: var(--line); overflow: hidden; }
.meter-fill { height: 100%; width: 0%; background: var(--accent); border-radius: inherit; transition: width .15s linear; }
.question-card { padding: clamp(18px, 4.8vw, 32px); }
.question-head { margin-bottom: 20px; }
.question-heading { font-size: clamp(1.35rem, 4.8vw, 1.8rem); line-height: 1.3; margin: 0 0 10px; }
.instruction { color: var(--muted); font-size: .96rem; margin: 0; }
.clockline { display: flex; gap: 8px; align-items: center; justify-content: space-between; padding: 10px 13px; margin: 0 0 18px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel-soft); font-variant-numeric: tabular-nums; }
.clock-label { color: var(--muted); font-size: .9rem; }
.clock-value { font-size: 1.08rem; font-weight: 800; min-width: 3.5ch; text-align: right; }
.prompt { font-size: 1.06rem; margin-bottom: 18px; }
.matrix-holder { display: flex; justify-content: center; margin: 10px auto 22px; max-width: 100%; }
.matrix-svg { width: min(100%, 350px); height: auto; color: var(--text); display: block; }
.option-grid { display: grid; grid-template-columns: 1fr; gap: 9px; margin: 18px 0; }
.option-grid.visual { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.option {
  display: flex; align-items: center; gap: 12px; text-align: left;
  border: 1px solid var(--line); background: var(--panel); color: var(--text);
  border-radius: 12px; min-height: 54px; padding: 10px 13px; width: 100%;
}
.option:hover { background: var(--panel-soft); }
.option[aria-pressed="true"] { border: 2px solid var(--accent); background: var(--accent-soft); padding: 9px 12px; }
.option-letter { width: 28px; height: 28px; border: 1px solid var(--line); border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: .8rem; font-weight: 800; flex: 0 0 auto; }
.option-graphic { min-height: 56px; display: flex; align-items: center; justify-content: center; }
.option-graphic svg { width: 68px; height: 68px; color: var(--text); }
.choice-label { flex: 1; }
.matrix-options .option { display: flex; flex-direction: column; gap: 4px; min-height: 112px; justify-content: center; }
.matrix-options .option-letter { align-self: flex-start; }
.error-note { color: var(--warn); min-height: 1.4em; font-size: .92rem; margin: 8px 0 0; }
.sequence { display: flex; flex-wrap: wrap; justify-content: center; gap: clamp(7px, 2vw, 13px); margin: 28px 0; }
.digit { font-size: clamp(1.85rem, 7vw, 2.6rem); font-weight: 750; line-height: 1.25; min-width: 1.05em; text-align: center; font-variant-numeric: tabular-nums; }
.recall-input { width: 100%; max-width: 440px; min-height: 56px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel); color: var(--text); font-size: 1.35rem; letter-spacing: .12em; font-variant-numeric: tabular-nums; }
.memory-area { display: grid; justify-items: center; gap: 14px; margin: 22px 0; }
.symbol-targets { display: flex; align-items: center; justify-content: center; gap: 16px; margin: 18px 0 24px; }
.target-symbol { border: 1px solid var(--line); border-radius: 12px; background: var(--panel-soft); padding: 7px; width: 74px; height: 74px; display: grid; place-items: center; }
.target-symbol svg { width: 58px; height: 58px; color: var(--text); }
.symbol-row { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; padding: 14px 8px; border: 1px solid var(--line); border-radius: 12px; background: var(--panel-soft); margin: 16px 0 24px; }
.symbol-cell { display: grid; place-items: center; width: clamp(39px, 11vw, 48px); height: clamp(39px, 11vw, 48px); border: 1px solid var(--line); border-radius: 8px; background: var(--panel); }
.symbol-cell svg { width: 36px; height: 36px; color: var(--text); }
.notice { border: 1px solid var(--line); border-radius: 10px; background: var(--panel-soft); color: var(--muted); padding: 11px 13px; font-size: .91rem; margin: 0 0 15px; }
.results-header { margin-bottom: 20px; }
.overall { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; padding: 18px; border: 1px solid var(--line); border-radius: 14px; background: var(--panel-soft); margin: 18px 0 16px; }
.overall-number { font-size: clamp(2.5rem, 10vw, 3.5rem); line-height: 1; font-weight: 800; letter-spacing: -.04em; font-variant-numeric: tabular-nums; }
.overall-copy { flex: 1; min-width: 190px; }
.overall-copy strong { display: block; margin-bottom: 4px; }
.chart-list { display: grid; gap: 18px; margin-top: 20px; }
.domain-result { border-bottom: 1px solid var(--line); padding-bottom: 17px; }
.domain-result:last-child { border-bottom: 0; }
.domain-line { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 7px; }
.domain-name { font-weight: 800; }
.domain-value { font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
.domain-meter { width: 100%; height: 12px; background: var(--line); border-radius: 999px; overflow: hidden; position: relative; }
.domain-meter-fill { height: 100%; background: var(--accent); border-radius: 999px; }
.domain-interpretation { color: var(--muted); font-size: .94rem; margin: 8px 0 0; }
.method-box { border: 1px solid var(--line); border-radius: 12px; padding: 16px; margin-top: 18px; }
.method-box h2 { margin-top: 0; }
footer { color: var(--muted); font-size: .83rem; text-align: center; padding: 18px 8px 0; }
.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
@media (max-width: 420px) {
  body { font-size: 16px; }
  .wrap { width: min(100% - 18px, 820px); padding-top: 12px; }
  .card { border-radius: 14px; }
  .option-grid:not(.visual) .option { align-items: flex-start; }
  .actions .btn { width: 100%; }
  .local-note { font-size: .77rem; }
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
}
</style>
</head>
